// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Register(in=nextValue, load=true, out=current);

    Inc16(in=current, out=incremented);

    Mux16(
        a=current,
        b=incremented,
        sel=inc,
        out=incValue
    );

    Mux16(
        a=incValue,
        b=in,
        sel=load,
        out=loadValue
    );

    Mux16(
        a=loadValue,
        b=false,
        sel=reset,
        out=nextValue
    );

    Mux16(
        a=false,
        b=current,
        sel=true,
        out=out
    );
}